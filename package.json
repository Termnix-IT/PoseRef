{
  "name": "poseref",
  "version": "0.1.1",
  "description": "Pose and composition reference maker for image-generation AI, with an MCP server so Claude Code and Codex can pose it",
  "keywords": [
    "pose",
    "reference",
    "mannequin",
    "mcp",
    "claude-code",
    "codex",
    "three.js"
  ],
  "homepage": "https://github.com/Termnix-IT/PoseRef#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Termnix-IT/PoseRef.git"
  },
  "bugs": {
    "url": "https://github.com/Termnix-IT/PoseRef/issues"
  },
  "license": "MIT",
  "type": "module",
  "bin": {
    "poseref": "dist-server/cli.js"
  },
  "files": [
    "dist/",
    "dist-server/"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "start": "npm run build && node dist-server/cli.js start",
    "build": "tsc -b && vite build && npm run build:server",
    "build:server": "vite build --ssr server/cli.ts --outDir dist-server --emptyOutDir",
    "typecheck": "tsc -b",
    "test": "node --test \"test/**/*.test.ts\"",
    "preview": "vite preview",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.0",
    "@modelcontextprotocol/server": "^2.1.0",
    "three": "^0.186.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@types/node": "^22.20.3",
    "@types/react": "19.2",
    "@types/react-dom": "19.2",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "19.2",
    "react-dom": "19.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "zustand": "^5.0.15"
  }
}
